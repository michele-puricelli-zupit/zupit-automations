package views

import "github.com/zupit-it/zupit-automations/internal/model"

templ Page(d Data) {

	<!DOCTYPE html>
	<html lang="it">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ `{"includeIndicatorStyles":false,"allowEval":false}` }/>
			<title>{ d.Title } · Smeesto</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer>
</script>
		</head>
		<body>
			<a href="#main" class="skip">Vai al contenuto</a>
			if d.User.ID == 0 {

				<main id="main" class="login-wrap">
					<div class="login-card">
<span class="brand-mark">S</span>
<h1>Smeesto</h1>
<p class="muted">Accedi con il tuo account Google aziendale.</p>
<a class="button primary login-button" href="/auth/login">Accedi con Google <span aria-hidden="true">↗</span>
</a>
</div>
				</main>
			} else {

				<div class="shell">
					<aside class="sidebar">
<a class="brand" href="/flows">
<span class="brand-mark">S</span>
<span>Smeesto
</span>
</a>
<nav aria-label="Navigazione principale">
						<a class={ navClass(d.Active, "flows")
} href="/flows">
<span aria-hidden="true">⇄</span> Flussi</a>
						<a class={ navClass(d.Active, "connections")
} href="/connections">
<span aria-hidden="true">⌁</span> Connessioni</a>
						<a class={ navClass(d.Active, "runs")
} href="/runs">
<span aria-hidden="true">≡</span> Esecuzioni</a>
					</nav>
<div class="profile">
<span class="avatar">{ initial(d.User.Name)
}</span>
<div>
<strong>{ d.User.Name }</strong>
<small>{ d.User.Email }</small>
<small>
if d.User.Admin {
<span>Amministratore</span>
} else {
<span>Sola lettura</span>
}</small>
</div>
</div>
<form method="post" action="/auth/logout">
<input type="hidden" name="_csrf" value={ d.CSRF }/>
<button class="logout" type="submit">Esci dall’account</button>
</form>
</aside>
					<main id="main" class="workspace">
<div class="content">
						if d.Active != "editor" {
							@Feedback(d)
						}
						switch d.Active {

							case "connections":
								if d.Connection.Provider != "" {
 @ConnectionForm(d)
} else {
 @Connections(d)
}
							case "editor":
								@FlowEditor(d)
							case "simulate":
								@Simulation(d)
							case "runs":
								if d.Run.ID != 0 {
 @RunDetail(d)
} else {
 @Runs(d)
}
							default:
								@Flows(d)
							}
						</div>
</main>
				</div>
			}
		</body>
	</html>
}

func navClass(active, name string) string { if active == name || (name == "flows" && (active == "editor" || active == "simulate")) { return "nav-active" }; return "" }
func initial(name string) string { for _, r := range name { return string(r) }; return "U" }

templ Feedback(d Data) {

	if d.Error != "" {
 <div class="alert error" role="alert">{ d.Error }</div>
}
	if d.Notice != "" {
 <div class="alert success" role="status">{ d.Notice }</div>
}
}
templ Badge(value string) {
 <span class={ "badge " + value }>{ status(value)
}</span>
}
templ Heading(title, description string) {
 <div class="heading">
<div>
<h1>{ title }</h1>
if description != "" {
<p class="muted">{ description }</p>
}
</div>{ children... }</div>
}
templ CSRF(token string) {
 <input type="hidden" name="_csrf" value={ token }/>
}

templ Flows(d Data) {

	@Heading("Flussi", "") {

		if d.User.Admin {
<form class="preset-picker" method="get" action="/flows/new">
<label class="field">
<span>Modello del nuovo flusso</span>
<select name="template">
<option value="">Flusso vuoto</option>
<option value="srt">SRT / Remedy</option>
<option value="cup">CUP</option>
<option value="kit">key2help</option>
<option value="support">Support KR</option>
</select>
</label>
<button class="button primary" type="submit">Crea flusso</button>
</form>
}
	}
	<div class="stats">
<div>
<span>FLUSSI</span>
<strong>{ ID(len(d.Flows))
}</strong>
</div>
<div>
<span>ATTIVI</span>
<strong>{ ID(enabledCount(d.Flows))
}</strong>
</div>
<div>
<span>CONNESSIONI PRONTE</span>
<strong>{ ID(readyCount(d.Connections))
}</strong>
</div>
</div>
	if len(d.Flows) == 0 {

		<div class="empty panel">
<span class="empty-icon" aria-hidden="true">⇄</span>
<h2>Nessun flusso</h2>
<a class="button secondary" href="/connections">Vai alle connessioni</a>
</div>
	} else {

		<div class="panel table-wrap">
<table>
<thead>
<tr>
<th>Flusso</th>
<th>Sorgente</th>
<th>Stato</th>
<th>Azioni</th>
</tr>
</thead>
<tbody>
for _, f := range d.Flows {
 <tr>
<td>
<strong>{ f.Name }</strong>
if f.Definition.Comparison != nil {
<small>Confronto Jev</small>
}
</td>
<td>{ sourceName(f.SourceID, d.Connections)
}</td>
<td>
if f.Enabled {
<span class="badge ready">Attivo</span>
} else {
<span class="badge">Disattivato</span>
}</td>
<td>
<div class="row-actions">
if d.User.Admin {
<a href={ templ.SafeURL(path("/flows/", f.ID))
}>Modifica</a>
<a href={ templ.SafeURL(path("/flows/", f.ID)+"/simulate")
}>Simula</a>
<form method="post" action={ path("/flows/",f.ID)+"/toggle" }>
@CSRF(d.CSRF)
<button class="link" type="submit">
if f.Enabled {
<span>Disattiva</span>
} else {
<span>Attiva</span>
}</button>
</form>
}</div>
</td>
</tr>
}</tbody>
</table>
</div>
	}
}
func enabledCount(flows []model.Flow) int { n:=0;for _,f:=range flows{if f.Enabled{n++}};return n }
func readyCount(connections []model.Connection) int { n:=0;for _,c:=range connections{if c.Status=="ready"{n++}};return n }

templ Connections(d Data) {

	@Heading("Connessioni", "")
	if d.User.Admin {
 <div class="connect-options">
<a href="/connections/new?provider=gmail">
<span class="provider gmail">G</span>
<strong>Collega Gmail</strong>
</a>
<a href="/connections/new?provider=jira">
<span class="provider jira">J</span>
<strong>Collega Jira</strong>
</a>
<a href="/connections/new?provider=slack">
<span class="provider slack">S</span>
<strong>Collega Slack</strong>
</a>
</div>
}
	if len(d.Connections) == 0 {
 <div class="panel empty">
<h2>Nessuna connessione configurata</h2>
</div>
} else {

		<div class="panel table-wrap">
<table>
<thead>
<tr>
<th>Connessione</th>
<th>Servizio</th>
<th>Stato</th>
<th>Gestione</th>
</tr>
</thead>
<tbody>
for _, c := range d.Connections {
<tr>
<td>
<strong>{ c.Name }</strong>
if c.Error!="" {
<small class="danger">{ c.Error }</small>
}</td>
<td>{ provider(c.Provider)
}</td>
<td>
@Badge(c.Status)
</td>
<td>
if d.User.Admin {
<div class="row-actions">
<a href={ templ.SafeURL(path("/connections/",c.ID))
}>Configura</a>
if c.Provider=="gmail" {
<form method="post" action={ path("/connections/",c.ID)+"/authorize" }>
@CSRF(d.CSRF)
<button type="submit" class="link">Autorizza Google</button>
</form>
}<form method="post" action={ path("/connections/",c.ID)+"/verify" }>
@CSRF(d.CSRF)
<button type="submit" class="link">Verifica</button>
</form>
</div>
}</td>
</tr>
}</tbody>
</table>
</div>
	}
}
templ Input(name,label,value,kind string,required bool) {

	<label class="field">
<span>{ label }</span>
<input name={ name } value={ value } type={ kind } required?={ required }/>
</label>
}
templ Textarea(name,label,value string) {
 <label class="field">
<span>{ label }</span>
<textarea name={ name } rows="4">{ value }</textarea>
</label>
}
templ ConnectionForm(d Data) {

	@Heading("Connessione "+provider(d.Connection.Provider), "") {
<a class="button secondary" href="/connections">Torna alle connessioni</a>
}
	<form class="panel form-panel" method="post" action={ path("/connections/",d.Connection.ID)
}>
@CSRF(d.CSRF)
<input type="hidden" name="provider" value={ d.Connection.Provider }/>
		@Input("name","Nome della connessione",d.Connection.Name,"text",true)
		if d.Connection.Provider=="gmail" {

			@Input("email","Indirizzo della casella Workspace",d.Connection.Config["email"],"email",true)
			@Input("topic","Topic Pub/Sub · projects/PROGETTO/topics/NOME",d.Connection.Config["topic"],"text",true)
			@Input("subscription","Subscription · projects/PROGETTO/subscriptions/NOME",d.Connection.Config["subscription"],"text",true)
			<p class="hint">Salva, poi premi «Autorizza Google» usando la casella indicata.</p>
		} else if d.Connection.Provider=="jira" {

			@Input("url","URL Jira Cloud",d.Connection.Config["url"],"url",true)
			@Input("email","Email dell’account tecnico",d.Connection.Config["email"],"email",true)
			<label class="field">
<span>Nuovo API token</span>
<input type="password" name="token" autocomplete="new-password"/>
<small>Lascia vuoto per mantenere il token esistente.</small>
</label>
		} else {

			<label class="field">
<span>Nuovo bot token Slack</span>
<input type="password" name="token" autocomplete="new-password"/>
<small>Lascia vuoto per mantenere il token esistente.</small>
</label>
			@Input("alert_channel","ID canale per gli avvisi operativi · facoltativo",d.Connection.Config["alert_channel"],"text",false)
			<p class="hint">Il bot deve accedere alle liste e al canale avvisi. Configura il canale su una sola connessione.</p>
		}
		<div class="form-footer">
<button class="button primary" type="submit">Salva connessione</button>
<a href="/connections">Annulla</a>
</div>
	</form>
}

templ EditorButton(operation,label string) {

	<button class="button small secondary" type="submit" name="operation" value={ operation } formaction="/flows/editor" formnovalidate hx-post="/flows/editor" hx-target="#flow-editor" hx-swap="outerHTML" hx-disabled-elt="this">{ label }</button>
}
templ FlowEditor(d Data) {

	<form id="flow-editor" method="post" action={ path("/flows/",d.Flow.ID)
}>
		@CSRF(d.CSRF)
<input type="hidden" name="id" value={ ID(d.Flow.ID)
}/>
		@Heading("Editor del flusso", "") {
<button class="button primary" type="submit">Salva flusso</button>
}
		@Feedback(d)
		<section class="panel form-panel">
<h2>
<span class="section-number">1</span> Sorgente</h2>
<div class="form-grid">
@Input("name","Nome del flusso",d.Flow.Name,"text",true)
<label class="field">
<span>Connessione Gmail</span>
<select name="source_id" required>
<option value="">Scegli la casella da cui leggere le email</option>
for _,c:=range d.Connections {
if c.Provider=="gmail" {
<option value={ ID(c.ID)
} selected?={ c.ID==d.Flow.SourceID }>{ c.Name }</option>
}
}</select>
</label>
</div>
<label class="check">
<input name="enabled" type="checkbox" checked?={ d.Flow.Enabled }/> Attiva al salvataggio: eseguirà azioni reali</label>
</section>
		@ComparisonEditor(d)
		<section class="panel form-panel">
<h2>
<span class="section-number">2</span> Email da elaborare</h2>
<p class="hint">Ogni email è valutata da tutti i flussi attivi. Senza condizioni si elaborano tutte le email della casella.</p>
@ConditionGroup("filter",d.Flow.Definition.Filter,d.Flow.Definition.Extractors)
@EditorButton("filter","＋ Condizione")
</section>
		<section class="panel form-panel">
<h2>
<span class="section-number">3</span> Dati da estrarre</h2>
<details class="field-help"><summary>Come estrarre un dato</summary><p class="hint">Un modello vuoto copia tutto il campo. Con un’espressione regolare (Go/RE2), la prima cattura diventa la variabile; i gruppi nominati sono disponibili con il proprio nome.</p></details>
			for i,e:=range d.Flow.Definition.Extractors {
<div class="editor-row extract-row">
@Input(key("extract",i,"name"),"Variabile",e.Name,"text",false)
@FieldSelect(key("extract",i,"source"),"Da dove prendere il dato",e.Source,nil)
@Input(key("extract",i,"pattern"),"Espressione regolare",e.Pattern,"text",false)
<label class="check">
<input type="checkbox" name={ key("extract",i,"required")
} checked?={ e.Required }/> Obbligatorio</label>
@EditorButton(key("remove","extract",i),"Rimuovi")
</div>
}
			@EditorButton("extract","＋ Estrazione")
		</section>
		<section class="panel form-panel">
<h2>
<span class="section-number">4</span> Rami e azioni</h2>
<p class="hint">Si esegue solo il primo ramo che corrisponde. Un ramo senza condizioni accetta tutte le email.</p>
			for bi,b:=range d.Flow.Definition.Branches {

				<div class="branch">
<div class="branch-header">
@Input(key("branch",bi,"name"),"Nome del ramo",b.Name,"text",false)
@EditorButton(key("remove","branch",bi),"Rimuovi ramo")
</div>
					@ConditionGroup(key("branch",bi,"when"),b.When,d.Flow.Definition.Extractors)
					@EditorButton(key("condition",bi),"＋ Condizione del ramo")
					for ai,a:=range b.Actions {
 @ActionEditor(d,bi,ai,a)
}
					@EditorButton(key("action",bi),"＋ Azione")
				</div>
			}
			@EditorButton("branch","＋ Ramo")
		</section>
		<details class="panel form-panel">
<summary>Usare i dati dell’email nelle azioni</summary>
<p>Usa <code>{ "{{ .subject }}" }</code> per l’oggetto, <code>{ "{{ .from }}" }</code> per il mittente e <code>{ "{{ .body }}" }</code> per il testo, oppure una variabile estratta. Funzioni disponibili: trim, lower, upper, replace, urlquery.</p>
</details>
		<div class="editor-save">
<a href="/flows">Annulla</a>
<button class="button primary" type="submit">Salva flusso</button>
</div>
	</form>
}
templ ComparisonEditor(d Data) {
	<details class="panel form-panel" open?={ d.Flow.Definition.Comparison != nil }>
		<summary>Confronto con Jev · facoltativo</summary>
		<label class="check"><input type="checkbox" name="comparison" checked?={ d.Flow.Definition.Comparison != nil }/> Abilita il confronto e invia il report al mio DM Slack</label>
		<p class="hint">Solo A esegue le azioni. Email e regole vengono inviate a TypeSafe; Jev propone un ramo (B), anche per le email escluse da A.</p>
		if !d.JevReady {
			<p class="hint">Per attivare Jev serve la chiave API TypeSafe sul server.</p>
		}
		@Textarea("comparison.instructions", "Regole per Jev", comparisonConfig(d.Flow.Definition).Instructions)
		<div class="form-grid">
			<label class="field"><span>Connessione Slack per il confronto</span>
				<select name="comparison.slack_connection_id">
					<option value="">Scegli Slack per il confronto</option>
					for _, c := range d.Connections {
						if c.Provider == "slack" {
							<option value={ ID(c.ID) } selected?={ c.ID == comparisonConfig(d.Flow.Definition).SlackConnectionID }>{ c.Name }</option>
						}
					}
				</select>
			</label>
			@Input("comparison.slack_recipient", "ID membro Slack o DM personale", comparisonConfig(d.Flow.Definition).SlackRecipient, "text", false)
		</div>
		<details class="field-help"><summary>Dove trovare l’ID Slack</summary><p class="hint">Profilo Slack → ⋯ → Copia ID membro (U…/W…). È accettato anche il DM personale del bot (D…). Il bot richiede chat:write e im:write.</p></details>
	</details>
}
templ FieldSelect(name,label,value string,extractors []model.Extractor) {

	<label class="field">
<span>{ label }</span>
<select name={ name }>
for _,field:=range choices("from","reply_to","to","subject","body","id","received_at") {
<option value={ field } selected?={ value==field }>{ choiceLabel(field) }</option>
}
for _,e:=range extractors {
<option value={ e.Name } selected?={ value==e.Name }>Dato estratto · { e.Name }</option>
}
if value!=""&&!knownField(value,extractors) {
<option value={ value } selected>Campo personalizzato · { value }</option>
}</select>
</label>
}
func knownField(s string,extractors []model.Extractor)bool{for _,v:=range []string{"from","reply_to","to","subject","body","id","received_at"}{if s==v{return true}};for _,e:=range extractors{if e.Name==s{return true}};return false}
templ ConditionGroup(prefix string,g model.Group,extractors []model.Extractor) {

	<label class="field">
<span>Quali condizioni devono essere vere?</span>
<select name={ prefix+".mode" }>
<option value="all" selected?={ g.Mode!="any" }>Tutte le condizioni</option>
<option value="any" selected?={ g.Mode=="any" }>Almeno una delle condizioni</option>
</select>
</label>
	for i,c:=range g.Conditions {
<div class="editor-row condition-row">
@FieldSelect(key(prefix,i,"field"),"Informazione da controllare",c.Field,extractors)
<label class="field">
<span>Come confrontarla</span>
<select name={ key(prefix,i,"operator")
}>
for _,op:=range choices("equals","prefix","contains","regex") {

<option value={ op } selected?={ c.Operator==op }>{ choiceLabel(op) }</option>
}</select>
</label>
@Input(key(prefix,i,"value"),"Testo o valore da cercare",c.Value,"text",false)
<label class="check">
<input name={ key(prefix,i,"ignore_case")
} type="checkbox" checked?={ c.IgnoreCase }/> Ignora maiuscole</label>
<label class="check">
<input name={ key(prefix,i,"not")
} type="checkbox" checked?={ c.Not }/> Escludi</label>
@EditorButton(key("remove","condition",prefix,i),"Rimuovi")
</div>
}
}
templ ActionEditor(d Data,bi,ai int,a model.Action) {

	<div class="action-editor">
<div class="action-heading">
<h3>Azione { ID(ai+1)
}</h3>
@EditorButton(key("remove","action",bi,ai),"Rimuovi azione")
</div>
<div class="form-grid">
<label class="field">
<span>Cosa deve fare l’automazione?</span>
<select name={ key("branch",bi,"action",ai,"kind")
} hx-post="/flows/editor" hx-trigger="change" hx-include="closest form" hx-target="#flow-editor" hx-swap="outerHTML">
for _,kind:=range choices("jira","jira_request","slack","forward","ignore") {

<option value={ kind } selected?={ a.Kind==kind }>{ action(kind)
}</option>
}</select>
</label>
		if a.Kind!="ignore" {
<label class="field">
<span>Connessione destinazione</span>
<select name={ key("branch",bi,"action",ai,"connection_id")
}>
<option value="">Scegli la connessione { provider(providerFor(a.Kind)) } da usare</option>
for _,c:=range d.Connections {
if c.Provider==providerFor(a.Kind) {
<option value={ ID(c.ID)
} selected?={ c.ID==a.ConnectionID }>{ c.Name }</option>
}
}</select>
</label>
}
		</div>
		if a.Kind=="jira"||a.Kind=="jira_request" {

			<div class="form-grid">
if a.Kind=="jira" {
@Input(key("branch",bi,"action",ai,"project"),"Chiave progetto Jira",a.Project,"text",false)
@Input(key("branch",bi,"action",ai,"issue_type"),"ID tipo ticket",a.IssueType,"text",false)
@Input(key("branch",bi,"action",ai,"board_id"),"ID board attesa",intValue(a.BoardID),"number",false)
} else {
@Input(key("branch",bi,"action",ai,"service_desk_id"),"ID Service Desk",a.ServiceDeskID,"text",false)
@Input(key("branch",bi,"action",ai,"request_type_id"),"ID tipo richiesta",a.RequestTypeID,"text",false)
@Input(key("branch",bi,"action",ai,"queue_id"),"ID coda attesa · facoltativo",intValue(a.QueueID),"number",false)
}
@Input(key("branch",bi,"action",ai,"reporter"),"Account ID richiedente · facoltativo",a.Reporter,"text",false)
</div>
if a.Kind=="jira" {
<p class="hint">La board dipende dai campi del ticket; sprint e notifiche dalle automazioni Jira.</p>
} else {
<p class="hint">La coda è facoltativa e dipende dai campi della richiesta. Per verificarla serve l’accesso Jira come agente.</p>
}
		}
		if a.Kind=="slack" {
@Input(key("branch",bi,"action",ai,"list_id"),"ID Slack List",a.ListID,"text",false)
}
		if a.Kind=="forward" {
@Input(key("branch",bi,"action",ai,"to"),"Destinatario dell’inoltro",a.To,"text",false)
}
		if a.Kind=="jira"||a.Kind=="jira_request"||a.Kind=="forward" {
@Input(key("branch",bi,"action",ai,"subject"),"Riepilogo / oggetto",a.Subject,"text",false)
@Textarea(key("branch",bi,"action",ai,"body"),"Descrizione / corpo dell’inoltro",a.Body)
}
		if a.Kind=="ignore" {
@Input(key("branch",bi,"action",ai,"reason"),"Motivo dell’esclusione",a.Reason,"text",false)
}
		if a.Kind=="jira"||a.Kind=="jira_request"||a.Kind=="slack" {
<h4>Campi di destinazione</h4>
for fi,f:=range a.Fields {
<div class="editor-row mapping-row">
@Input(key("branch",bi,"action",ai,"field",fi,"field"),"ID campo / colonna",f.Field,"text",false)
<label class="field">
<span>Che tipo di dato inviare?</span>
<select name={ key("branch",bi,"action",ai,"field",fi,"type")
}>
for _,typ:=range choices("text","number","boolean","option","user","date","link","json") {

<option value={ typ } selected?={ f.Type==typ }>{ choiceLabel(typ) }</option>
}</select>
</label>
@Input(key("branch",bi,"action",ai,"field",fi,"value"),"Valore o template",f.Value,"text",false)
@EditorButton(key("remove","field",bi,ai,fi),"Rimuovi")
</div>
}
@EditorButton(key("field",bi,ai),"＋ Campo")
}
	</div>
}
func intValue(v int)string{if v==0{return ""};return ID(v)}

templ Simulation(d Data) {

	@Heading("Simula · "+d.Flow.Name, "Non invia email né crea ticket o elementi nelle liste.") {
<a href={ templ.SafeURL(path("/flows/",d.Flow.ID))
} class="button secondary">Modifica flusso</a>
}
	if d.Flow.Definition.Comparison != nil {
		<p class="hint">La simulazione verifica solo le regole standard (A).</p>
	}
	<form class="panel form-panel" method="post" action={ path("/flows/",d.Flow.ID)+"/simulate" }>
@CSRF(d.CSRF)
<label class="field">
<span>Email completa in formato RFC822</span>
<textarea class="code" name="raw" rows="14" required placeholder="From: mittente@example.test&#10;To: team@example.test&#10;Subject: Segnalazione&#10;&#10;Testo del messaggio">{ d.Raw }</textarea>
</label>
<button type="submit" class="button primary">Simula elaborazione</button>
</form>
	if d.Simulation!="" {
<section class="panel form-panel">
<h2>Risultato: { d.Branch }</h2>
<pre>{ d.Simulation }</pre>
</section>
}
}

templ Runs(d Data) {

	@Heading("Esecuzioni", "Ultime 100 elaborazioni.")
	<div id="runs-table" hx-get="/runs" hx-trigger="every 10s" hx-target="this" hx-select="#runs-table" hx-swap="outerHTML">
		if len(d.Runs)==0 {
<div class="panel empty">
<h2>Nessuna esecuzione</h2>
</div>
} else {
<div class="panel table-wrap">
<table>
<thead>
<tr>
<th>Email / flusso</th>
<th>Ricezione nell’app</th>
<th>Stato</th>
<th>Durata elaborazione</th>
<th>
</th>
</tr>
</thead>
<tbody>
for _,r:=range d.Runs {
<tr>
<td>
<strong>{ r.Subject }</strong>
<small>{ r.FlowName }</small>
</td>
<td>{ date(r.CreatedAt)
}</td>
<td>
@Badge(r.Status)
</td>
<td>{ latency(r)
}</td>
<td>
<a href={ templ.SafeURL(path("/runs/",r.ID))
}>Dettaglio →</a>
</td>
</tr>
}</tbody>
</table>
</div>
}
	</div>
}
templ ComparisonDetail(c model.Comparison, runID int) {
	<section id="comparison-result" class="panel form-panel" hx-get={ path("/runs/", runID) } hx-trigger="every 10s" hx-select="#comparison-result" hx-swap="outerHTML">
		<div class="action-heading"><h2>Confronto A/B · Jev</h2>@Badge(c.Status)</div>
		<p class="hint">A esegue le azioni; B propone soltanto. Gli esiti effettivi sono riportati sotto.</p>
		if c.Error != "" {
			<p class="alert error">{ c.Error }</p>
		}
		if c.Reference != "" {
			<p class="fine">Report Slack: { c.Reference }</p>
		}
		if c.Result.Model != "" {
			<p class="fine">{ comparisonInfo(c.Result) }</p>
			<pre>{ pretty(c.Result) }</pre>
		}
	</section>
}

templ RunDetail(d Data) {

	@Heading(d.Run.Subject, d.Run.FlowName+" · "+date(d.Run.CreatedAt)) {
<a class="button secondary" href="/runs">Tutte le esecuzioni</a>
}
	<div class="run-summary">
@Badge(d.Run.Status)
<span class="fine">Durata: { latency(d.Run)
} · Gmail ID: { d.Run.MessageID }</span>
</div>
	if d.Run.Comparison != nil {
		@ComparisonDetail(*d.Run.Comparison, d.Run.ID)
	}
	for _,s:=range d.Run.Steps {
<section class="panel form-panel">
<div class="action-heading">
<h2>{ action(s.Action.Kind)
}</h2>
@Badge(s.Status)
</div>
<p class="fine">Tentativi: { ID(s.Attempts)
}</p>
if s.Reference!="" {
if safeReference(s.Reference) {
<a href={ templ.SafeURL(s.Reference)
} rel="noopener noreferrer" target="_blank">Apri destinazione ↗</a>
} else {
<p>{ s.Reference }</p>
}
}if s.Error!="" {
<p class="alert error">{ s.Error }</p>
}
		if d.User.Admin&&(s.Status=="failed"||s.Status=="uncertain"||s.Status=="warning")&&s.Action.Kind!="ignore" {

			<form method="post" action={ path("/steps/",s.ID)+"/resolve" }>
@CSRF(d.CSRF)
@Input("reference","Riferimento verificato nella destinazione",s.Reference,"text",true)
<button class="button secondary" type="submit">Conferma esito già riuscito</button>
</form>
			if s.Reference==""&&s.Status!="warning" {
<form method="post" action={ path("/steps/",s.ID)+"/retry" } class="retry-form">
@CSRF(d.CSRF)if s.Status=="uncertain" {
<label class="check">
<input type="checkbox" name="confirmed" value="yes" required/> Ho verificato che l’azione non è stata eseguita nella destinazione</label>
}<button class="button secondary" type="submit">Riprova questa azione</button>
</form>
}
		}
	</section>
}
}
