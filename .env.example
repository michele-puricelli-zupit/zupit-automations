# Copiare in .env; Compose legge questo file, il binario Go legge l'ambiente.
APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
GOOGLE_CLIENT_ID=
AUTH_ALLOWED_DOMAINS=zupit.it
ADMIN_EMAILS=
TZ=Europe/Rome

# Per il binario locale. Compose imposta i percorsi /run/secrets corrispondenti.
DATABASE_URL_FILE=./secrets/database_url
GOOGLE_CLIENT_SECRET_FILE=./secrets/google_client_secret
CSRF_SECRET_FILE=./secrets/csrf_secret
ENCRYPTION_KEY_FILE=./secrets/encryption_key
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google_credentials.json

# Immagine da costruire localmente o pubblicare nel proprio registry per Portainer.
AUTOMATIONS_IMAGE=zupit-automations:local

# Opzionale: confronto B con Jev. Per Docker usare anche compose.jev.yaml.
TYPESAFE_API_KEY_FILE=
TYPESAFE_MODEL=jev-latest
