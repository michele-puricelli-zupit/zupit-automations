# Variabili/segreti dell'ambiente GitHub production, come per Zupit Eventi.
# Hostname proposto: creare il DNS e registrare entrambe le callback Google.
APP_HOSTNAME=automazioni.zupit.software
TRAEFIK_STACK=zupit-automations-production
TRAEFIK_CERT_RESOLVER=zupit-software-resolver
GOOGLE_CLIENT_ID=
AUTH_ALLOWED_DOMAINS=zupit.it
ADMIN_EMAILS=michele.puricelli@zupit.it

# Segreti nuovi per un database nuovo; conservare ENCRYPTION_KEY se si importa un DB.
POSTGRES_PASSWORD=
# La password nella URL deve essere percent-encoded.
DATABASE_URL=postgres://automations:PASSWORD_PERCENT_ENCODED@postgres:5432/automations?sslmode=disable
GOOGLE_CLIENT_SECRET=
CSRF_SECRET=
ENCRYPTION_KEY=
# JSON ADC completo dell'identita con accesso alla subscription Pub/Sub.
GOOGLE_CREDENTIALS_JSON=

# Opzionale: confronto B. La chiave viene passata all'environment dell'app.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Valore fornito dalla pipeline, non aggiungere un secret con questo nome.
# Per un deploy manuale usare l'immagine pubblicata con tag SHA o digest.
# APP_IMAGE_TAG=ghcr.io/OWNER/REPOSITORY/zupit-automations-production:COMMIT_SHA
